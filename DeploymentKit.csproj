<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <GenerateRuntimeConfigurationFiles>false</GenerateRuntimeConfigurationFiles>
    <PackageId>DeploymentKit</PackageId>
    <Version>1.0.0-preview.2</Version>
    <Title>DeploymentKit</Title>
    <Description>Opinionated, validation-first infrastructure-as-code library for provisioning production-grade Azure environments with Pulumi: PostgreSQL, Redis, Container Apps, Key Vault, networking, monitoring, green-blue deployments, and drift recovery. Designed to be driven safely by both humans and AI agents.</Description>
    <Authors>Anton Kharchenko</Authors>
    <Copyright>Copyright © Anton Kharchenko 2026</Copyright>
    <PackageProjectUrl>https://github.com/anton-kharchenko/DeploymentKit</PackageProjectUrl>
    <RepositoryUrl>https://github.com/anton-kharchenko/DeploymentKit</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>pulumi;azure;infrastructure-as-code;iac;deployment;orchestration;container-apps;postgresql;ai-agents</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Preview release of DeploymentKit. Preview/runtime dependencies remain where required by the current .NET 10 and Pulumi stack.</PackageReleaseNotes>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <RootNamespace>DeploymentKit</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageReference Include="Pulumi" Version="3.101.2" />
    <PackageReference Include="Pulumi.Automation" Version="3.101.2" />
    <PackageReference Include="Pulumi.AzureNative" Version="3.14.0" />
    <PackageReference Include="Pulumi.Command" Version="4.6.0-alpha.1662390243" />
    <PackageReference Include="Azure.Core" Version="1.52.0" />
    <PackageReference Include="Azure.Identity" Version="1.20.0" />
    <PackageReference Include="Azure.ResourceManager" Version="1.14.0-beta.1" />
    <PackageReference Include="Azure.ResourceManager.Resources" Version="1.11.2" />
    <PackageReference Include="Azure.ResourceManager.PostgreSql" Version="1.4.1" />
    <PackageReference Include="Azure.ResourceManager.EventHubs" Version="1.3.0-beta.1" />
    <PackageReference Include="Azure.ResourceManager.Network" Version="1.15.0" />
    <PackageReference Include="Azure.ResourceManager.Storage" Version="1.6.0" />
    <PackageReference Include="Azure.ResourceManager.KeyVault" Version="1.3.3" />
    <PackageReference Include="Azure.ResourceManager.ContainerRegistry" Version="1.5.0-beta.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
  </ItemGroup>
</Project>
